---
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---

<dl class="hud-stats">
  {
    items.map((item) => (
      <div class="hud-stats__item">
        <dt class="hud-stats__label">{item.label}</dt>
        <dd class="hud-stats__value">{item.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .hud-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0;
    text-align: left;
  }

  .hud-stats__label {
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    color: var(--muted);
    text-transform: uppercase;
  }

  .hud-stats__value {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--sun);
  }

  @media (max-width: 640px) {
    .hud-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      text-align: center;
    }
  }
</style>
