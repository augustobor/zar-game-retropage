---
// Lista de datos "🎮 Clave ······ valor", uno por línea (fichas de juego y de logro).
export interface Stat {
  label: string;
  value: string;
  /** Emoji que hace de viñeta */
  icon?: string;
}

interface Props {
  items: Stat[];
}
const { items } = Astro.props;
---

<dl class="stat-list">
  {
    items.map((item) => (
      <div class="stat-list__item">
        <dt class="stat-list__label">
          {item.icon && <span class="stat-list__icon" aria-hidden="true">{item.icon}</span>}
          {item.label}
        </dt>
        <dd class="stat-list__value">{item.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stat-list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .stat-list__item {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  /* Línea de puntos entre clave y valor, estilo menú de juego */
  .stat-list__item::after {
    content: '';
    order: 1;
    flex: 1 1 0.75rem;
    min-width: 0.75rem;
    border-bottom: 2px dotted rgb(255 255 255 / 0.15);
    transform: translateY(-0.25em);
  }

  .stat-list__label {
    flex: none;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .stat-list__icon {
    width: 1.3em;
    text-align: center;
  }

  .stat-list__value {
    order: 2;
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--sun);
    text-align: right;
  }
</style>
