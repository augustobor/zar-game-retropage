---
// Siluetas decorativas de palmeras para el horizonte del Hero.
// Cada grupo es un SVG propio con su viewBox ajustado al dibujo y pegado a su esquina:
// se escala con "meet", así las hojas nunca quedan recortadas en pantallas angostas.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['palms', className]} aria-hidden="true">
  <svg class="palms__group palms__group--left" viewBox="40 20 260 280" preserveAspectRatio="xMinYMax meet">
    <g fill="currentColor">
      <path d="M120 300 C 128 220 140 160 168 96 l6 3 C 150 165 140 225 136 300 Z"></path>
      <path d="M170 98 c -40 -30 -90 -28 -120 -6 c 40 -6 80 0 118 12 Z"></path>
      <path d="M170 98 c 20 -45 70 -62 110 -50 c -40 10 -78 30 -104 56 Z"></path>
      <path d="M170 98 c 50 -10 98 10 118 40 c -36 -20 -78 -30 -116 -34 Z"></path>
      <path d="M170 98 c -30 4 -62 30 -72 64 c 22 -30 48 -48 76 -58 Z"></path>
      <path d="M170 98 c -10 -40 -50 -68 -88 -70 c 34 18 62 42 84 74 Z"></path>
    </g>
  </svg>

  <svg class="palms__group palms__group--right" viewBox="880 80 290 220" preserveAspectRatio="xMaxYMax meet">
    <g fill="currentColor">
      <path d="M1040 300 C 1034 240 1022 190 996 140 l -6 3 C 1012 195 1022 245 1024 300 Z"></path>
      <path d="M994 142 c 34 -26 78 -24 104 -4 c -36 -6 -70 0 -102 10 Z"></path>
      <path d="M994 142 c -16 -40 -60 -54 -96 -44 c 36 8 68 26 92 50 Z"></path>
      <path d="M994 142 c -44 -8 -86 8 -104 36 c 32 -18 68 -26 102 -30 Z"></path>
      <path d="M994 142 c 26 4 54 28 62 58 c -18 -26 -42 -42 -66 -52 Z"></path>
      <path d="M1110 300 C 1106 260 1098 228 1080 196 l -5 2 C 1090 232 1096 264 1096 300 Z"></path>
      <path d="M1078 198 c 24 -18 56 -16 74 -2 c -26 -4 -50 0 -72 6 Z"></path>
      <path d="M1078 198 c -12 -28 -42 -38 -68 -30 c 26 6 48 18 64 36 Z"></path>
      <path d="M1078 198 c -30 -4 -58 8 -70 28 c 22 -12 46 -18 70 -22 Z"></path>
    </g>
  </svg>
</div>

<style>
  .palms {
    pointer-events: none;
  }

  .palms__group {
    position: absolute;
    bottom: 0;
    height: 100%;
    width: auto;
    /* En celular no pueden tapar el título: cada grupo ocupa como mucho 45% del ancho */
    max-width: 45%;
  }

  .palms__group--left {
    left: 0;
  }

  .palms__group--right {
    right: 0;
  }
</style>
