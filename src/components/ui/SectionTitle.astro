---
interface Props {
  /** Para enlazar la sección con aria-labelledby */
  id?: string;
  /** Número decorativo ("01", "02"…) */
  index?: string;
  /** Contador opcional a la derecha del título ("14/55") */
  count?: string;
}
const { id, index, count } = Astro.props;
---

<h2 class="section-title" id={id}>
  {index && <span class="section-title__index">{index}</span>}
  <slot />
  {count && <span class="section-title__count">{count}</span>}
</h2>

<style>
  .section-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 2.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 4rem);
    background: linear-gradient(90deg, var(--sun), var(--orange) 40%, var(--pink));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .section-title__index,
  .section-title__count {
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    -webkit-text-fill-color: var(--teal);
  }

  .section-title__count {
    -webkit-text-fill-color: var(--sun);
  }
</style>
