---
// Estado de una cuenta como pantalla de HUD retro:
// titular (lo que está haciendo) + fichas con el resto de los datos.
import type { Presence } from '../../lib/types';

interface Props {
  presence: Presence;
  /** "Rich Presence" (RA) o "Estado en Steam" */
  title: string;
}
const { presence, title } = Astro.props;
const { headline, fields } = presence;
const hasFields = fields.length > 0;
// Punto verde titilando si está activo; gris y quieto si está desconectado
const dotClass = presence.online === false ? 'presence-screen__dot presence-screen__dot--offline' : 'presence-screen__dot';
---

<div class="presence-screen">
  <p class="presence-screen__label"><span class={dotClass} aria-hidden="true"></span>{title}</p>

  {headline && <p class="presence-screen__headline">{headline}</p>}

  {
    hasFields && (
      <ul class="presence-screen__fields">
        {fields.map((field) => (
          <li class="presence-screen__field">
            {field.label && <span class="presence-screen__key">{field.label}</span>}
            <span class="presence-screen__value">{field.value}</span>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  /* Pantalla CRT: fondo oscuro, borde con brillo y scanlines */
  .presence-screen {
    position: relative;
    display: grid;
    gap: 0.7rem;
    margin-top: 0.9rem;
    padding: 0.9rem 1rem 1rem;
    overflow: hidden;
    border-radius: 10px;
    background:
      radial-gradient(ellipse at top left, rgb(25 227 201 / 0.12), transparent 60%),
      #0a0614;
    border: 1px solid rgb(25 227 201 / 0.35);
    box-shadow:
      inset 0 0 24px rgb(0 0 0 / 0.6),
      0 0 18px rgb(25 227 201 / 0.12);
  }

  .presence-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }

  .presence-screen__label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--muted);
    text-transform: uppercase;
  }

  .presence-screen__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 8px #3ddc84;
    animation: blink 1.6s steps(1) infinite;
  }

  .presence-screen__dot--offline {
    background: var(--muted);
    box-shadow: none;
    animation: none;
  }

  /* Lo que está haciendo ahora: el dato principal */
  .presence-screen__headline {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--teal);
    text-shadow: 0 0 10px rgb(25 227 201 / 0.45);
  }

  .presence-screen__headline::before {
    content: '▸ ';
    color: var(--pink);
  }

  /* ---------- Fichas: se ajustan a varias líneas, nunca se cortan ---------- */

  .presence-screen__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .presence-screen__field {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.85rem;
    line-height: 1.3;
  }

  .presence-screen__key {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--pink);
    text-transform: uppercase;
  }

  .presence-screen__value {
    color: var(--sun);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .presence-screen__dot {
      animation: none;
    }
  }
</style>
