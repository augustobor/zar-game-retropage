---

interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
}
const { kicker, title, subtitle } = Astro.props;
---

<header class="page-header synthwave-grid">
  <div class="container">
    <p class="kicker">{kicker}</p>
    <h1 class="page-header__title">{title}</h1>
    {subtitle && <p class="page-header__subtitle">{subtitle}</p>}
  </div>
</header>

<style>
  .page-header {
    padding: 8rem 0 3rem;
    background: linear-gradient(180deg, var(--bg) 0%, #2a0f45 45%, #6b1d6b 78%, #d6336c 100%);
    border-bottom: 3px solid var(--orange);
  }

  .page-header__title {
    margin: 0.3em 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.5rem, 12vw, 7rem);
    line-height: 0.9;
    background: var(--sunset);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 5px 0 var(--plum));
  }

  .page-header__subtitle {
    margin: 0.2em 0 0;
    font-family: var(--font-script);
    font-size: clamp(1.4rem, 4vw, 2rem);
    color: var(--teal);
    transform: rotate(-3deg);
    transform-origin: left;
  }
</style>
