---
import type { FilterOption } from '../../lib/format';

interface Props {
  options: FilterOption[];
  /** Nombre accesible del grupo de filtros */
  label: string;
  searchPlaceholder: string;
}
const { options, label, searchPlaceholder } = Astro.props;
const filters = options.map((option, i) => ({ ...option, pressed: i === 0 ? 'true' : 'false' }));
---

<div class="collection-toolbar">
  <div class="collection-toolbar__filters" role="group" aria-label={label}>
    {
      filters.map((filter) => (
        <button type="button" class="collection-toolbar__filter" data-filter={filter.id} aria-pressed={filter.pressed}>
          {filter.label} <span class="collection-toolbar__count">{filter.count}</span>
        </button>
      ))
    }
  </div>

  <label class="collection-toolbar__search">
    <span class="visually-hidden">{searchPlaceholder}</span>
    <span class="collection-toolbar__search-icon" aria-hidden="true">⌕</span>
    <input class="collection-toolbar__input" type="search" data-search placeholder={searchPlaceholder} autocomplete="off" spellcheck="false" />
  </label>
</div>

<style>
  .collection-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* ---------- Filtros ---------- */

  .collection-toolbar__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .collection-toolbar__filter {
    padding: 0.7rem 1.1rem;
    font: inherit;
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--ink);
    background: var(--surface);
    border: 2px solid var(--violet);
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 3px 3px 0 var(--violet);
    transition:
      translate 0.1s,
      box-shadow 0.1s;
  }

  .collection-toolbar__filter:hover {
    translate: -1px -1px;
    box-shadow: 4px 4px 0 var(--violet);
  }

  .collection-toolbar__filter[aria-pressed='true'] {
    background: linear-gradient(90deg, var(--pink), var(--orange));
    border-color: var(--sun);
    box-shadow: 3px 3px 0 var(--sun);
  }

  .collection-toolbar__count {
    margin-left: 0.4rem;
    color: var(--sun);
  }

  .collection-toolbar__filter[aria-pressed='true'] .collection-toolbar__count {
    color: var(--bg);
  }

  /* ---------- Buscador ---------- */

  .collection-toolbar__search {
    position: relative;
    flex: 1 1 240px;
    max-width: 360px;
  }

  .collection-toolbar__search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    translate: 0 -50%;
    font-size: 1.3rem;
    color: var(--pink);
    pointer-events: none;
  }

  .collection-toolbar__input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.4rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--bg);
    border: 2px solid var(--surface-2);
    border-radius: 8px;
    box-shadow: inset 0 2px 0 rgb(0 0 0 / 0.35);
    transition: border-color 0.15s;
  }

  .collection-toolbar__input::placeholder {
    color: var(--muted);
  }

  .collection-toolbar__input:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow:
      inset 0 2px 0 rgb(0 0 0 / 0.35),
      0 0 0 3px rgb(25 227 201 / 0.2);
  }

  @media (max-width: 640px) {
    .collection-toolbar__search {
      max-width: none;
    }
  }
</style>
