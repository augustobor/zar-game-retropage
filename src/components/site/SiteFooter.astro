---
import { profile } from '../../data/profile';

const year = new Date().getFullYear();
const builtAt = new Date().toLocaleString('es-AR', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'America/Argentina/Buenos_Aires',
});
---

<footer class="site-footer container">
  <p class="site-footer__credits">© {year} {profile.handle} · Datos de Steam y RetroAchievements · actualizado {builtAt}</p>
  <p class="site-footer__press" aria-hidden="true">PRESS START</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 5rem;
    padding: 2rem 0 3rem;
    border-top: 2px solid var(--surface-2);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .site-footer__credits {
    margin: 0;
  }

  .site-footer__press {
    margin: 0;
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--pink);
    animation: blink 1.2s steps(1) infinite;
  }
</style>
