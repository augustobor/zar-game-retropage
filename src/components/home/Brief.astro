---
import SectionTitle from '../ui/SectionTitle.astro';
import Prose from '../ui/Prose.astro';
import ChipList from '../ui/ChipList.astro';
import PlatformList from '../ui/PlatformList.astro';
import Timeline from '../ui/Timeline.astro';
import AccountList from '../profile/AccountList.astro';
import type { Platform, SourceData } from '../../lib/types';
import { profile } from '../../data/profile';

interface Props {
  /** Cuentas de Steam y RA: estado y último juego (se actualizan en vivo cada 60 s) */
  sources: SourceData[];
  /** Steam + consolas de RetroAchievements + extras de profile.ts */
  platforms: Platform[];
}
const { sources, platforms } = Astro.props;
const { bio, location, favorites, timeline } = profile;
const locationLabel = `📍 ${location}`;
---

<section class="brief section container" id="brief" aria-labelledby="brief-title">
  <SectionTitle id="brief-title">Brief</SectionTitle>

  <AccountList sources={sources} />

  <article class="panel">
    <h3 class="panel__label">Biografía</h3>
    <Prose paragraphs={bio} />
    <p class="brief__location">{locationLabel}</p>

    <h3 class="panel__label">Plataformas</h3>
    <PlatformList items={platforms} />

    <h3 class="panel__label">Favoritos de siempre</h3>
    <ChipList items={favorites} tone="orange" />
  </article>

  <Timeline items={timeline} />
</section>

<style>
  .brief__location {
    margin: 0;
    color: var(--muted);
  }
</style>
