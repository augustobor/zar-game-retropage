---

interface Props {
  /** Valores de 0 a 100 */
  items: { label: string; value: number }[];
}
const bars = Astro.props.items.map((item) => ({ ...item, style: `--value:${item.value}%` }));
---

<ul class="stat-bars">
  {
    bars.map((bar) => (
      <li class="stat-bars__row">
        <span class="stat-bars__label">{bar.label}</span>
        <span class="stat-bars__bar" style={bar.style} role="meter" aria-label={bar.label} aria-valuenow={bar.value} aria-valuemin="0" aria-valuemax="100" />
        <span class="stat-bars__value">{bar.value}</span>
      </li>
    ))
  }
</ul>

<style>
  .stat-bars {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .stat-bars__row {
    display: grid;
    grid-template-columns: 7.5rem 1fr 2.5rem;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .stat-bars__bar {
    height: 14px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 3px;
    background: var(--surface-2) linear-gradient(90deg, var(--pink), var(--orange) 70%, var(--sun)) no-repeat;
    background-size: var(--value) 100%;
    box-shadow: inset 0 0 0 2px var(--bg);
  }

  .stat-bars__value {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--sun);
    text-align: right;
  }

  @media (max-width: 800px) {
    .stat-bars__row {
      grid-template-columns: 6.5rem 1fr 2.2rem;
    }
  }
</style>
