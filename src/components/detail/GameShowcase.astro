---
import FloatCard from './FloatCard.astro';
import ProgressBar from '../ui/ProgressBar.astro';
import type { GameDetail } from '../../lib/types';
import { percent } from '../../lib/format';

interface Props {
  game: GameDetail;
}
const { game } = Astro.props;

const pct = percent(game.unlocked, game.total);
const hasAchievements = game.total > 0;
const cover = game.cover ?? game.icon;
const coverAlt = `Portada de ${game.title}`;
const coverClass = `game-showcase__cover game-showcase__cover--${game.source}`;
const countLabel = hasAchievements ? `${game.unlocked}/${game.total} logros · ${pct}%` : 'Sin logros';
const progressLabel = `Progreso de logros de ${game.title}`;
---

<FloatCard>
  <figure class="game-showcase">
    <div class={coverClass}>
      {cover && <img class="game-showcase__image" src={cover} alt={coverAlt} data-fallback={game.coverFallback} />}
    </div>
    <figcaption class="game-showcase__caption">
      <span class="game-showcase__platform">{game.platform}</span>
      <span class="game-showcase__title">{game.title}</span>
      {hasAchievements && <ProgressBar value={pct} label={progressLabel} />}
      <span class="game-showcase__count">{countLabel}</span>
    </figcaption>
  </figure>
</FloatCard>

<script>
  import '../../scripts/image-fallback';
</script>

<style>
  .game-showcase {
    margin: 0;
  }

  .game-showcase__cover {
    display: grid;
    place-items: center;
    aspect-ratio: 2 / 3;
    background: linear-gradient(160deg, var(--plum), #6b1d6b 60%, #d6336c);
  }

  .game-showcase__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* RA: el box art es casi cuadrado y de proporciones variables, se muestra entero */
  .game-showcase__cover--retro {
    aspect-ratio: 1;
  }

  .game-showcase__cover--retro .game-showcase__image {
    width: 86%;
    height: 86%;
    object-fit: contain;
    filter: drop-shadow(4px 6px 0 rgb(0 0 0 / 0.4));
  }

  .game-showcase__caption {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.2rem;
  }

  .game-showcase__platform {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--teal);
    text-transform: uppercase;
  }

  .game-showcase__title {
    font-weight: 700;
    line-height: 1.25;
  }

  .game-showcase__count {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
