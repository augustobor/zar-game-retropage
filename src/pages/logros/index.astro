---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import AccountList from '../../components/profile/AccountList.astro';
import AchievementList from '../../components/achievements/AchievementList.astro';
import { getProfileData, getAchievementList } from '../../lib/data';
import { profile } from '../../data/profile';

const [{ retro, steam }, achievements] = await Promise.all([getProfileData(), getAchievementList()]);
const sources = [steam, retro];
const title = `Logros · ${profile.handle}`;
const description = `Sala de trofeos de ${profile.handle}: logros de Steam y RetroAchievements.`;
---

<Base title={title} description={description}>
  <PageHeader kicker="// Sala de trofeos" title="Logros" subtitle="Steam + RetroAchievements" />
  <main class="container">
    <AccountList sources={sources} />
    <AchievementList achievements={achievements} />
  </main>
</Base>
