---
import ProgressBar from '../ui/ProgressBar.astro';
import { formatNumber, formatPercent, rarityTier } from '../../lib/format';

interface Props {
  /** % de jugadores que tienen el logro */
  rarity: number;
  /** Cantidad absoluta de jugadores (solo RA) */
  awarded?: number;
}
const { rarity, awarded } = Astro.props;

const tier = rarityTier(rarity)!;
const className = `rarity-meter rarity-meter--${tier.id}`;
const percentLabel = formatPercent(rarity);
const detail = awarded != null ? `${formatNumber(awarded)} jugadores lo tienen` : 'de los jugadores lo tiene';
const value = Math.max(1, Math.round(rarity));
---

<div class={className}>
  <p class="rarity-meter__tier">{tier.label}</p>
  <p class="rarity-meter__value">
    <span class="rarity-meter__percent">{percentLabel}</span>
    <span class="rarity-meter__detail">{detail}</span>
  </p>
  <ProgressBar value={value} label="Porcentaje de jugadores con este logro" size="lg" />
</div>

<style>
  /* Cada nivel define su color; el texto y la barra lo toman de --tier */
  .rarity-meter--common { --tier: var(--rarity-common); }
  .rarity-meter--uncommon { --tier: var(--rarity-uncommon); }
  .rarity-meter--rare { --tier: var(--rarity-rare); }
  .rarity-meter--epic { --tier: var(--rarity-epic); }
  .rarity-meter--legendary { --tier: var(--rarity-legendary); }

  .rarity-meter {
    display: grid;
    gap: 0.6rem;
    /* ProgressBar usa estas variables para su degradé */
    --progress-from: color-mix(in srgb, var(--tier) 55%, var(--bg));
    --progress-to: var(--tier);
  }

  .rarity-meter__tier {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--tier);
    text-shadow: 0 0 18px color-mix(in srgb, var(--tier) 45%, transparent);
  }

  .rarity-meter__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  .rarity-meter__percent {
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    color: var(--tier);
  }

  .rarity-meter__detail {
    color: var(--muted);
  }
</style>
