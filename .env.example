# Copiá este archivo como .env y completá tus datos.
# Sin estas variables el sitio igual compila, pero muestra datos de demo.

# RetroAchievements → https://retroachievements.org/settings (sección "Keys")
RA_USERNAME=
RA_API_KEY=

# Steam: tu SteamID64 (17 dígitos) o tu URL personalizada (steamcommunity.com/id/<esto>)
STEAM_ID=
# Opcional. Sin key se usa el perfil público (XML). Con key se obtienen todos los juegos y logros.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- Opcionales: si quedan vacías se usan los valores por defecto ---
# Máximo de logros publicados en /logros/ (default 500). Más logros = HTML más pesado.
MAX_ACHIEVEMENTS=
# Ventana de logros recientes de RetroAchievements, en minutos (default 1051200 = 2 años).
# 1 día = 1440 · 1 año = 525600
RECENT_MINUTES=
