---
import Base from '../../layouts/Base.astro';
import DetailHero from '../../components/detail/DetailHero.astro';
import AchievementShowcase from '../../components/detail/AchievementShowcase.astro';
import RelatedGame from '../../components/detail/RelatedGame.astro';
import RelatedAchievements from '../../components/detail/RelatedAchievements.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import ChipList from '../../components/ui/ChipList.astro';
import StatList from '../../components/ui/StatList.astro';
import { getAchievementRoutes, getAchievementDetail } from '../../lib/data';
import { profile } from '../../data/profile';
import { url } from '../../lib/url';
import { ACHIEVEMENT_TYPES, SOURCE_LABELS, definedStats, formatDateTime, rarityTier } from '../../lib/format';

const RELATED_COUNT = 4;

/** Una página por cada logro desbloqueado: /logros/retro-5760/, /logros/steam-1774580-…/ (los bloqueados no tienen) */
export async function getStaticPaths() {
  const routes = await getAchievementRoutes();
  return routes.map(({ id, gameId }) => ({ params: { id }, props: { id, gameId } }));
}

interface Props {
  id: string;
  gameId: string;
}
const { achievement, game } = await getAchievementDetail(Astro.props.id, Astro.props.gameId);
if (!achievement?.unlockedAt) return Astro.redirect(url('/logros/'));

const title = `${achievement.title} · ${achievement.game} · ${profile.handle}`;
const description = `${achievement.title}: ${achievement.description}`;
const sourceLabel = SOURCE_LABELS[achievement.source];
const kicker = `// Logro de ${sourceLabel}`;
const isRetro = achievement.source === 'retro';
const typeLabel = achievement.type ? (ACHIEVEMENT_TYPES[achievement.type] ?? achievement.type) : undefined;
// "37 · x3,7": puntos reales y cuántas veces más difícil que sus puntos nominales
const difficulty =
  achievement.trueRatio && achievement.points
    ? `${achievement.trueRatio} · x${(achievement.trueRatio / achievement.points).toLocaleString('es-AR', { maximumFractionDigits: 1 })}`
    : undefined;
const externalHref = isRetro
  ? `https://retroachievements.org/achievement/${achievement.id.replace('retro-', '')}`
  : `https://steamcommunity.com/stats/${achievement.gameId.replace('steam-', '')}/achievements`;

const chips = [
  achievement.points != null ? `${achievement.points} pts` : '',
  achievement.hardcore ? 'Hardcore' : '',
  typeLabel ?? '',
  rarityTier(achievement.rarity)?.label ?? '',
].filter(Boolean);

const details = definedStats([
  { icon: '🕹️', label: 'Juego', value: achievement.game },
  { icon: '🎮', label: 'Plataforma', value: achievement.platform },
  { icon: '💎', label: 'Puntos', value: achievement.points },
  { icon: '📈', label: 'RetroRatio', value: difficulty },
  { icon: '🧩', label: 'Tipo', value: typeLabel },
  { icon: '🔥', label: 'Modo', value: isRetro && (achievement.hardcore ? 'Hardcore' : 'Softcore') },
  { icon: '📅', label: 'Desbloqueado', value: formatDateTime(achievement.unlockedAt) },
]);

const related = (game?.achievements ?? []).filter((a) => a.unlockedAt && a.id !== achievement.id).slice(0, RELATED_COUNT);
const hasRelated = related.length > 0;
const relatedTitle = `Más de ${achievement.game}`;
---

<Base title={title} description={description}>
  <DetailHero
    backHref={url('/logros/')}
    backLabel="Logros"
    kicker={kicker}
    title={achievement.title}
    lead={achievement.description}
    externalHref={externalHref}
    externalLabel={`Ver en ${sourceLabel} ↗`}
  >
    <AchievementShowcase slot="card" achievement={achievement} />
    <ChipList items={chips} tone="sun" />
  </DetailHero>

  <main class="container">
    <!-- La rareza está en el dorso de la tarjeta (AchievementShowcase) -->
    <section class="section stack" aria-label="Detalle del logro">
      <article class="panel">
        <h2 class="panel__label">Detalles</h2>
        <StatList items={details} />
      </article>

      {
        game && (
          <article class="panel">
            <h2 class="panel__label">Juego</h2>
            <RelatedGame game={game} />
          </article>
        )
      }
    </section>

    {
      hasRelated && (
        <section class="section" aria-labelledby="relacionados-title">
          <SectionTitle id="relacionados-title">{relatedTitle}</SectionTitle>
          <RelatedAchievements achievements={related} />
        </section>
      )
    }
  </main>
</Base>
