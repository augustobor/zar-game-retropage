---

interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
}
const { kicker, title, subtitle } = Astro.props;
---

<header class="page-header">
  <div class="page-header__content container">
    <p class="kicker">{kicker}</p>
    <h1 class="page-header__title">{title}</h1>
    {subtitle && <p class="page-header__subtitle">{subtitle}</p>}
  </div>
</header>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding: 8rem 0 3rem;
    background: linear-gradient(180deg, var(--bg) 0%, #2a0f45 45%, #6b1d6b 78%, #d6336c 100%);
    border-bottom: 3px solid var(--orange);
  }

  /* Grilla synthwave que se desvanece hacia arriba */
  .page-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background:
      repeating-linear-gradient(90deg, rgb(255 46 136 / 0.35) 0 1px, transparent 1px 60px),
      repeating-linear-gradient(0deg, rgb(25 227 201 / 0.3) 0 1px, transparent 1px 20px);
    mask: linear-gradient(transparent, #000);
  }

  .page-header__content {
    position: relative;
    z-index: 1;
  }

  .page-header__title {
    margin: 0.3em 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.5rem, 12vw, 7rem);
    line-height: 0.9;
    background: var(--sunset);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 5px 0 var(--plum));
  }

  .page-header__subtitle {
    margin: 0.2em 0 0;
    font-family: var(--font-script);
    font-size: clamp(1.4rem, 4vw, 2rem);
    color: var(--teal);
    transform: rotate(-3deg);
    transform-origin: left;
  }
</style>
