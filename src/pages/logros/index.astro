---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import AchievementList from '../../components/achievements/AchievementList.astro';
import { getAchievementList, getPlatformIcons } from '../../lib/data';
import { profile } from '../../data/profile';

const [achievements, platformIcons] = await Promise.all([getAchievementList(), getPlatformIcons()]);
const title = `Logros · ${profile.handle}`;
const description = `Sala de trofeos de ${profile.handle}: logros de Steam y RetroAchievements.`;
---

<Base title={title} description={description}>
  <PageHeader kicker="// Sala de trofeos" title="Logros" subtitle="Steam + RetroAchievements" />
  <main class="container">
    <AchievementList achievements={achievements} platformIcons={platformIcons} />
  </main>
</Base>
