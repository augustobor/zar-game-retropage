---

interface Props {
  items: { year: string; title: string; text: string }[];
}
const { items } = Astro.props;
---

<ol class="timeline">
  {
    items.map((item) => (
      <li class="timeline__item">
        <span class="timeline__year">{item.year}</span>
        <h3 class="timeline__title">{item.title}</h3>
        <p class="timeline__text">{item.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin: 3rem 0 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-top: 2px dashed rgb(255 46 136 / 0.4);
  }

  .timeline__year {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    color: var(--pink);
  }

  .timeline__title {
    margin: 0.6rem 0 0.3rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
  }

  .timeline__text {
    margin: 0;
    color: var(--muted);
  }
</style>
